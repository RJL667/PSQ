.vercel
__pycache__/
*.pyc
scans.db
quotes.db
.env
node_modules/
quote_pdfs/
*.db-journal
*.db-wal
*.db-shm
~$*

# Backup folder (contains full repo copy)
Backup/

# Binary / generated files
*.pdf
*.docx
*.xlsx
package-lock.json
security_scanner/scanner.db

# Screenshots and generated output
SME Rating Engine/manual_screenshots/
SME Rating Engine/Quotes/
# Rendered card-verification / calibration output (regenerate via tooling/_verify_calib_cards.py)
security_scanner/docs/calibration_prep/calib_verify/
# Test fixtures - large JSON baselines are local-only (regenerate from any scan)
security_scanner/test_fixtures/phishield_baseline.json
security_scanner/test_fixtures/test_*.pdf

# Spec-convergence workspace fixtures (regenerable scan outputs)
security_scanner/_spec_workspace/substrate/sample/*.json

# API keys / secrets (custom-named env files)
security_scanner/ATT66027.env

# age binary (downloaded by the Render build, never committed)
security_scanner/bin/

# Local reference scans for card back-testing (contain org breach data — never commit)
security_scanner/test_fixtures/phishield_live.json
security_scanner/preview_scans.db

# Local Claude Code state
.claude/worktrees/

# Runtime cache of the DeHashed credit balance. Written by the app, must NOT
# ship in a deploy tarball — it would overwrite the VM's live value with a
# stale one from a dev machine or a test run.
security_scanner/scans/_dehashed_balance.json
security_scanner/scans/_dehashed_balance_history.jsonl
security_scanner/scans/_dehashed_cache/
# Runtime caches written by the scanner at execution time. _egress_ip.json in
# particular records whichever machine last ran the code, so a developer's own
# address lands in the repo -- it did, in 61bcf37.
security_scanner/scans/_egress_ip.json
security_scanner/scans/_dehashed_probe.json
.computer/
.vgexec/
attachments/
backups/
# Local scratch: server pulls, deploy manifests, sample proposal PDFs
tmp/
# Personal email signature assets (kept in the workspace, not the public repo)
email-signature/
.secrets/
.tmp/
# Casebook: client forms, quotes, threads and results stay local. Only the pipeline code,
# its helper tools and the scrubbed rule notes are tracked.
casebook/*
!casebook/pipeline/
!casebook/tools/
!casebook/quote_check/
!casebook/conditions_template.md
!casebook/underwriting_nuances.md
casebook/pipeline/**/*
!casebook/pipeline/**/
!casebook/pipeline/**/*.py
!casebook/pipeline/**/*.mjs
casebook/pipeline/**/__pycache__/
# client-case regression harnesses (they name the cases they score)
casebook/pipeline/email/regress.py
casebook/pipeline/forms/score_conditions.py
casebook/pipeline/forms/score_scan_rows.py
casebook/tools/*
!casebook/tools/build_backfill.py
!casebook/tools/form_ocr.sh
casebook/quote_check/*
!casebook/quote_check/check_quote.py
!casebook/quote_check/README.md
